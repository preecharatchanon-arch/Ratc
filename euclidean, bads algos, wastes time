static pair<double, double> direct_arc_time_dist(
    const Compressed &CG,
    int a,
    int b
) {
    if (a == b) return {0.0, 0.0};

    double best_d = INF_D;
    double best_t = INF_D;

    if (a < 0 || a >= (int)CG.out_edges.size()) {
        return {INF_D, INF_D};
    }

    for (int eid : CG.out_edges[a]) {
        const EdgeC &e = CG.edges[eid];

        if (e.v != b) continue;

        double d = e.length_m;
        double t = e.travel_time(8 * 3600.0);

        if (d < best_d) {
            best_d = d;
            best_t = t;
        }
    }

    return {best_t, best_d};
}

