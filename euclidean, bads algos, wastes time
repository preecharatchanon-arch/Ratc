static bool parse_bool_arg(const string &s) {
    string x = s;
    transform(x.begin(), x.end(), x.begin(), ::tolower);

    return (
        x == "1" ||
        x == "true" ||
        x == "yes" ||
        x == "y" ||
        x == "on"
    );
}

